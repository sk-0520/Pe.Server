// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/php
{
	"name": "Pe.Server",
	"dockerComposeFile": "compose.yaml",
	"service": "www",
	"workspaceFolder": "/app",
	"mounts": [
		{
			"type": "bind",
			"source": "${localWorkspaceFolder}",
			"target": "${containerWorkspaceFolder}"
		}
	],
	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},
	// Configure tool-specific properties.
	// "customizations": {},
	// ポートは compose.yaml 側で publish 済み (80/443)。
	// forwardPorts で二重に forward するとホスト側ポート占有と衝突し、
	// TunnelService の再試行ループで renderer が OOM するため使用しない。
	"overrideCommand": false,
	"customizations": {
		"vscode": {
			"extensions": [
				"bmewburn.vscode-intelephense-client",
				"neilbrayfield.php-docblocker",
				"editorconfig.editorconfig",
				"mehedidracula.php-namespace-resolver",
				"sibiraj-s.vscode-scss-formatter",
				"formulahendry.auto-close-tag",
				"mrmlnc.vscode-apache",
				"kasik96.latte",
				"xdebug.php-debug",
				"santacodes.santacodes-region-viewer",
				"timonwong.shellcheck",
				"sanderronde.phpstan-vscode",
				"mads-hartmann.bash-ide-vscode",
				"streetsidesoftware.code-spell-checker",
				"EditorConfig.EditorConfig",
				"MehediDracula.php-namespace-resolver",
				"SanderRonde.phpstan-vscode"
			],
			"settings": {
				// 自動転送も同じ衝突を起こすため無効化 (compose の publish を直接使う)
				"remote.autoForwardPorts": false,
				"workbench.colorCustomizations": {
					"activityBar.foreground": "#ffffff",
					"activityBar.background": "#777bb3",
					"activityBar.activeBorder": "#ffffff",
					"activityBar.inactiveForeground": "#fff",
					"activityBar.activeFocusBorder": "#f00",
					"activityBar.activeBackground": "#000",
					"titleBar.activeForeground": "#ffffff",
					"titleBar.activeBackground": "#777bb3",
					"titleBar.inactiveForeground": "#ffffff",
					"titleBar.inactiveBackground": "#777bb3",
					"statusBar.foreground": "#ffffff",
					"statusBar.background": "#777bb3",
				}
			}
		}
	}
	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "sudo chmod a+x \"$(pwd)\" && sudo rm -rf /var/www/html && sudo ln -s \"$(pwd)\" /var/www/html"
	// "postStartCommand": "npm ci",
	// "postAttachCommand": "npm run build"
	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
